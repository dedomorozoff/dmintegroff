{
  "name": "ЮKassa",
  "description": "Создание платежа в ЮKassa",
  "type": "json",
  "category": "payments",
  "template": {
    "amount": {
      "value": "{{payment.amount}}",
      "currency": "RUB"
    },
    "description": "{{payment.description}}",
    "receipt": {
      "customer": {
        "email": "{{user.email}}"
      },
      "items": [{
        "description": "{{item.description}}",
        "quantity": "1",
        "amount": {
          "value": "{{payment.amount}}",
          "currency": "RUB"
        },
        "vat_code": 1
      }]
    },
    "confirmation": {
      "type": "redirect",
      "return_url": "https://example.com/return"
    }
  }
}