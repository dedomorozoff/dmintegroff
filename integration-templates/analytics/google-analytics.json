{
  "name": "Google Analytics 4",
  "description": "Отправка события в Google Analytics 4",
  "type": "json",
  "category": "analytics",
  "template": {
    "client_id": "{{user.id}}",
    "events": [{
      "name": "webhook_received",
      "params": {
        "event_category": "webhook",
        "event_label": "{{event.type}}",
        "user_email": "{{user.email}}",
        "custom_parameter": "{{custom.value}}"
      }
    }]
  }
}