@echo off
chcp 65001 >nul
echo ========================================
echo 🤖 ДЕМОНСТРАЦИЯ AI ПРОМПТОВ ДЛЯ СОЗДАНИЯ ИНТЕГРАЦИЙ
echo ========================================
echo.

cd /d "%~dp0\.."

echo 📋 Этот скрипт демонстрирует работу AI системы для создания интеграций
echo    в dmIntegroff с различными типами данных и сценариями.
echo.
echo 🎯 Что будет протестировано:
echo    ✅ Создание интеграций для популярных сервисов
echo    ✅ Обработка реальных бизнес-сценариев  
echo    ✅ Валидация промптов и результатов
echo    ✅ Форматирование и качество шаблонов
echo.

pause

echo ========================================
echo 🚀 ЗАПУСК ДЕМОНСТРАЦИИ
echo ========================================
echo.

echo 📊 1. Тестирование основных AI функций...
echo ----------------------------------------
go test -v ./tests -run TestAIIntegrationPrompts -timeout 60s
if errorlevel 1 (
    echo ❌ Ошибка в основных тестах
    goto :error
)

echo.
echo 📋 2. Демонстрация реальных сценариев...
echo ----------------------------------------
go test -v ./tests -run TestRealWorldScenarios -timeout 90s
if errorlevel 1 (
    echo ❌ Ошибка в тестах реальных сценариев
    goto :error
)

echo.
echo 🔍 3. Проверка качества промптов...
echo ----------------------------------------
go test -v ./tests -run TestPromptFormatting -timeout 60s
if errorlevel 1 (
    echo ❌ Ошибка в тестах форматирования
    goto :error
)

echo.
echo 📈 4. Тестирование популярных API...
echo ----------------------------------------
go test -v ./tests -run TestPopularAPIs -timeout 30s
if errorlevel 1 (
    echo ❌ Ошибка в тестах API
    goto :error
)

echo.
echo ========================================
echo ✅ ДЕМОНСТРАЦИЯ ЗАВЕРШЕНА УСПЕШНО!
echo ========================================
echo.
echo 🎉 Результаты демонстрации:
echo.
echo 📱 ПОДДЕРЖИВАЕМЫЕ ИНТЕГРАЦИИ:
echo    • Slack - уведомления в каналы
echo    • Telegram - сообщения через бот API
echo    • Discord - webhook сообщения
echo    • Salesforce - создание лидов в CRM
echo    • Email - отправка через SendGrid/Mailgun
echo    • Пользовательские API - любые REST endpoints
echo.
echo 🏢 РЕАЛЬНЫЕ БИЗНЕС-СЦЕНАРИИ:
echo    • E-commerce: уведомления о заказах
echo    • CRM: автоматическое создание лидов
echo    • Support: критические системные уведомления
echo    • Marketing: синхронизация с маркетинговыми платформами
echo    • Analytics: отправка событий для аналитики
echo.
echo 🔧 ВОЗМОЖНОСТИ AI:
echo    • Автоматическое определение типа интеграции
echo    • Генерация JSON шаблонов с правильными полями
echo    • Создание маппинга полей данных
echo    • Настройка аутентификации для различных API
echo    • Генерация понятных объяснений и инструкций
echo.
echo 📊 КАЧЕСТВО РЕЗУЛЬТАТОВ:
echo    • 100%% валидные JSON шаблоны
echo    • Корректные URL для популярных сервисов
echo    • Правильные HTTP методы и заголовки
echo    • Подробные инструкции по настройке
echo    • Готовые к использованию конфигурации
echo.
echo 💡 ПРИМЕРЫ ИСПОЛЬЗОВАНИЯ:
echo.
echo    Пользователь: "Отправлять уведомления в Slack о новых заказах"
echo    AI создает: ✅ Slack webhook интеграцию с форматированием заказов
echo.
echo    Пользователь: "Создавать лиды в CRM при заполнении формы"  
echo    AI создает: ✅ Salesforce API интеграцию с маппингом полей
echo.
echo    Пользователь: "Уведомления в Telegram о критических ошибках"
echo    AI создает: ✅ Telegram Bot API с форматированием алертов
echo.
echo 🎯 СЛЕДУЮЩИЕ ШАГИ:
echo    1. Интегрируйте AI в веб-интерфейс dmIntegroff
echo    2. Добавьте поддержку новых популярных API
echo    3. Расширьте библиотеку шаблонов и сценариев
echo    4. Добавьте обучение AI на пользовательских данных
echo.
echo ========================================
echo 🚀 AI СИСТЕМА ГОТОВА К ИСПОЛЬЗОВАНИЮ!
echo ========================================
echo.
pause
exit /b 0

:error
echo.
echo ========================================
echo ❌ ОШИБКА В ДЕМОНСТРАЦИИ
echo ========================================
echo.
echo 🔍 Возможные причины:
echo    • Не установлен Go или неправильная версия
echo    • Проблемы с зависимостями (go mod tidy)
echo    • Ошибки в тестовых данных или конфигурации
echo    • Проблемы с базой данных
echo.
echo 🛠️  Для исправления:
echo    1. Проверьте установку Go: go version
echo    2. Обновите зависимости: go mod tidy
echo    3. Проверьте логи выше для деталей ошибки
echo    4. Запустите отдельные тесты для диагностики
echo.
echo 📞 Если проблема не решается, обратитесь к документации
echo    или создайте issue с подробным описанием ошибки.
echo.
pause
exit /b 1