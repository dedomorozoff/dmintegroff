# Configuration for GIntegra

# Server Port (Default: 8080)
PORT=8080

# Database Configuration
# Options: sqlite, mysql
DB_TYPE=sqlite

# Database Connection String
# For SQLite: path to file (e.g., gintegra.db)
# For MySQL: user:password@tcp(localhost:3306)/dbname?charset=utf8mb4&parseTime=True&loc=Local
DB_DSN=gintegra.db

# Session Secret (Change this in production!)
SESSION_SECRET=your-secret-key-change-me

# Gin Mode
# Options: debug, release
GIN_MODE=debug

# Logging
# Options: debug, info, warn, error
LOG_LEVEL=info
# Path to log file (leave empty for stdout only)
LOG_FILE=gintegra.log
