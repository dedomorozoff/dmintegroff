# 🚀 dmIntegroff Configuration Example
# Copy this file to .env and update the values

# ===================
# Server Settings
# ===================
PORT=8080
HOST=0.0.0.0
GIN_MODE=debug

# Base URL of the application (used for generating webhook URLs)
# ⚠️ IMPORTANT: Set this to your external URL if behind proxy/landing
# Examples:
#   Development: http://localhost:8080
#   Production: https://yourdomain.com
#   Behind landing: http://localhost:3000 (landing port)
BASE_URL=http://localhost:8080

# ===================
# Database Settings
# ===================
# Options: sqlite, mysql
DB_TYPE=sqlite

# For SQLite (default):
DB_DSN=db/dmintegroff.db

# For MySQL:
# DB_DSN=user:password@tcp(127.0.0.1:3306)/dmIntegroff?charset=utf8mb4&parseTime=True&loc=Local

# ===================
# Security Settings
# ===================
# ⚠️ IMPORTANT: Change this in production!
# Generate with: openssl rand -hex 32
SESSION_SECRET=your-super-secret-key-change-this-in-production

# Custom application path (optional)
# Example: /api/v1 or leave empty for root
APP_PATH=

# ===================
# Logging Settings
# ===================
# Options: debug, info, warn, error
LOG_LEVEL=debug

# Log file path (leave empty for stdout only)
LOG_FILE=logs/app.log

# ===================
# Development Settings
# ===================
# Enable debug mode (set to false in production)
DEBUG=true

# ===================
# Demo Mode Settings
# ===================
# Enable demo mode (allows auto-registration via GET parameters)
# ⚠️ WARNING: Only enable this for demo/testing environments!
DEMO_MODE=false

# Demo mode shared secret (required for demo user registration)
# Generate with: openssl rand -hex 32
#DEMO_SHARED_SECRET=cf7d2769e371a362b238fbee62cfff175583aba05de8abc4f960c5755f9d756c

# Demo target URL (webhooks in demo mode can only be sent to this URL)
# This prevents abuse by restricting webhook destinations
#DEMO_TARGET_URL=https://webhook.site/your-demo-webhook-id

# ===================
# Redis Settings (Optional)
# ===================
# Redis URL for webhook test storage (optional, falls back to database if not set)
# Format: redis://[user:password@]host:port/db
# 
# Examples:
#   Local without password:
#     REDIS_URL=redis://localhost:6379/0
#   
#   Local with password:
#     REDIS_URL=redis://:your_password@localhost:6379/0
#   
#   Remote with auth:
#     REDIS_URL=redis://user:password@redis.example.com:6379/0
#   
#   Redis Cloud:
#     REDIS_URL=redis://default:password@redis-12345.cloud.redislabs.com:12345
#   
#   With TLS (rediss://):
#     REDIS_URL=rediss://user:password@redis.example.com:6380/0
#
# Benefits of using Redis:
#   ✅ 5-10x faster than database
#   ✅ Automatic expiration (TTL)
#   ✅ Less load on main database
#   ✅ Easy to scale
#
# If not set, webhook tests will use the main database (works fine for most cases)
#REDIS_URL=redis://localhost:6379/0

# ===================
# Production Settings
# ===================
# Uncomment and configure for production:

# Use release mode
#GIN_MODE=release

# Use MySQL for better performance
#DB_TYPE=mysql
#DB_DSN=user:password@tcp(mysql-host:3306)/dmIntegroff?charset=utf8mb4&parseTime=True&loc=Local

# Set proper base URL
#BASE_URL=https://yourdomain.com

# Disable debug mode
#DEBUG=false

# Use info or warn log level
#LOG_LEVEL=info

# Disable demo mode
#DEMO_MODE=false

# Use Redis for webhook tests
#REDIS_URL=redis://:password@redis-host:6379/0

# ===================
# Notes
# ===================
# 1. Never commit .env file to git (it's in .gitignore)
# 2. Always use strong SESSION_SECRET in production
# 3. Use HTTPS in production (configure reverse proxy)
# 4. Enable Redis for better performance with webhook tests
# 5. Regular backups of database are recommended
# 6. Monitor logs for errors and security issues
