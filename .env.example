# 🚀 dmIntegroff Configuration

# ===================
# Server Settings
# ===================
PORT=8080
GIN_MODE=debug

# Base URL of the application (used for generating webhook URLs)
# Example: http://localhost:8080 or https://yourdomain.com
APP_URL=http://localhost:8080

# ===================
# Database Settings
# ===================
# Options: sqlite, mysql
DB_TYPE=sqlite

# For SQLite (default):
DB_DSN=dmintegroff.db

# For MySQL (uncomment and configure):
# DB_DSN=user:password@tcp(localhost:3306)/dmintegroff?charset=utf8mb4&parseTime=True&loc=Local

# ===================
# Security Settings
# ===================
# ⚠️ IMPORTANT: Change this in production!
SESSION_SECRET=your-super-secret-key-change-this-in-production

# Custom application path (optional)
# Example: /api/v1 or leave empty for root
APP_PATH=

# ===================
# Logging Settings
# ===================
# Options: debug, info, warn, error
LOG_LEVEL=info

# Log file path (leave empty for stdout only)
LOG_FILE=dmintegroff.log

# ===================
# Development Settings
# ===================
# Enable debug mode (set to false in production)
DEBUG=true

# Hot reload (for development)
# HOT_RELOAD=true

# ===================
# Demo Mode Settings
# ===================
# Enable demo mode (allows auto-registration via GET parameters)
DEMO_MODE=false

# Demo mode secret key (required for demo user registration)
DEMO_SECRET=your-demo-secret-key

# Shared secret for HMAC signature verification (must match landing .env)
# ⚠️ IMPORTANT: Generate a strong random string (32+ characters)
# Example: openssl rand -hex 32
DEMO_SHARED_SECRET=change-this-to-a-long-random-string-min-32-chars

# Demo target URL (webhooks in demo mode can only be sent to this URL)
DEMO_TARGET_URL=https://webhook.site/your-demo-webhook-id
